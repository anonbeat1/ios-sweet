+static void
+w_bdf_segment(void)
+{
+	struct wmsg m;
+	uint32_t chunk = MIN(w_bdf_len - w_bdf_off, (uint32_t)WLFW_SEG);
+	bool end = w_bdf_off + chunk >= w_bdf_len;
+
+	if (!wm_new(&m, WLFW_BDF_DOWNLOAD)) {
+		return;
+	}
+	wm_u8(&m, 0x01, 1);                    /* valid */
+	wm_u32(&m, 0x10, 0);                   /* file_id = 0 (ELF/REGDB) */
+	wm_u32(&m, 0x11, w_bdf_len);           /* total_size */
+	wm_u32(&m, 0x12, w_bdf_seg);           /* seg_id */
+	uint8_t *t = m.b + m.n;                /* data TLV: u16 len + bytes */
+	uint16_t tl = (uint16_t)(2 + chunk), dl = (uint16_t)chunk;
+	t[0] = 0x13;
+	memcpy(t + 1, &tl, 2);
+	memcpy(t + 3, &dl, 2);
+	if (fw_read_at(w_bdf_name, w_bdf_off, t + 5, chunk) != (int64_t)chunk) {
+		LOG("wlfw: %s read failed at %u", w_bdf_name, w_bdf_off);
+		IOFree(m.b, 8192);
+		return;
+	}
+	m.n += 5 + chunk;
+	wm_u8(&m, 0x14, end ? 1 : 0);          /* end */
+	wm_u8(&m, 0x15, w_bdf_type);           /* bdf_type */
+	wm_send(&m);
+	w_bdf_off += chunk;
+	w_bdf_seg++;
+	w_step = "bdf download";
+}
+
+static void
+w_start_bdf(const char *name, uint8_t type)
+{
+	int64_t sz = fw_size(name);
+	if (sz <= 0) {
+		LOG("wlfw: %s missing (%lld); skipping", name, sz);
+		return;
+	}
+	w_bdf_name = name;
+	w_bdf_type = type;
+	w_bdf_len = (uint32_t)sz;
+	w_bdf_off = 0;
+	w_bdf_seg = 0;
+	LOG("t=%u ms: wlfw: downloading %s type %u, %u bytes", g_ms, name, type, w_bdf_len);
+	w_bdf_segment();
+}
