+static int64_t
+fw_read_at(const char *name, uint64_t off, void *dst, uint64_t n)
+{
+	char path[96];
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int resid = 0, err;
+
+	snprintf(path, sizeof(path), FW_DIR "%s", name);
+	if (vnode_open(path, FREAD, 0, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)dst, (int)n, (off_t)off, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &resid, current_proc());
+	vnode_close(vp, FREAD, ctx);
+	return err != 0 ? -1 : (int64_t)(n - resid);
+}
