 #define GCC_PA                  0x00100000
-#define GCC_SIZE                0x00090000
-#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
+#define GCC_SIZE                0x001f0000      /* yupik GCC is 0x1f0000; Spacewar GDSC is at 0x10f004 */
 #define CBCR_CLK_OFF            (1u << 31)
 
+/*
+ * Board parameters. sweet (SM7150, gcc-sdmmagpie) is the compiled-in default;
+ * Spacewar (SM7325, gcc-yupik) overrides them from ADT /sweet-usb: the USB30
+ * GDSC and the master/cfg-noc clocks sit at different GCC offsets, the HS PHY
+ * is snps-femto (no QUSB2 register block to probe), and the controller is
+ * behind apps_smmu (stream 0xe0) so its DMA needs a translating context bank.
+ * sweet has no node and no SMMU on USB, so nothing changes there.
+ */
+static uint32_t usb_gdscr_off   = 0x0f004;      /* GDSC USB30_PRIM status */
+static uint32_t usb_master_off  = 0x0f010;      /* master CBCR (gates DWC3 regs) */
+static uint32_t usb_cfgnoc_off  = 0x0502c;      /* cfg-noc-axi CBCR (gates DWC3 regs) */
+static uint32_t usb_smmu_sid    = 0;            /* 0 = no SMMU (sweet) */
+static bool     usb_has_qusb2   = true;         /* sweet probes the QUSB2 PHY */
+
+static void
+usb_board_params(void)
+{
+	DTEntry node;
+	const uint32_t *v;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/sweet-usb", &node) != kSuccess) {
+		return;
+	}
+	if (SecureDTGetProperty(node, "gdscr-off", (void const **)&v, &size) == kSuccess && size == 4) {
+		usb_gdscr_off = *v;
+	}
+	if (SecureDTGetProperty(node, "master-off", (void const **)&v, &size) == kSuccess && size == 4) {
+		usb_master_off = *v;
+	}
+	if (SecureDTGetProperty(node, "cfgnoc-off", (void const **)&v, &size) == kSuccess && size == 4) {
+		usb_cfgnoc_off = *v;
+	}
+	if (SecureDTGetProperty(node, "smmu-sid", (void const **)&v, &size) == kSuccess && size == 4) {
+		usb_smmu_sid = *v;
+	}
+	if (SecureDTGetProperty(node, "no-qusb2", (void const **)&v, &size) == kSuccess) {
+		usb_has_qusb2 = false;
+	}
+}
+
 static const struct {
