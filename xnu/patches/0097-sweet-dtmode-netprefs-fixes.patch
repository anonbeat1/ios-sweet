diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612dbe3dd2..e4fd5d642e20 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5541,6 +5541,51 @@ bad:
 }
 
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: processes named in boot-arg sweetdtmode (comma separated basenames)
+ * get OS_ACTIVITY_DT_MODE=YES, which makes libsystem_trace mirror os_log
+ * messages to stderr. launchd points daemons' stderr at /dev/null, and the
+ * /dev/null tee (boot-arg sweetnull, bsd/dev/mem.c) puts it in the console
+ * log: a way to read a daemon's own logs without logd.
+ */
+static bool
+sweet_exec_dtmode(const char *path)
+{
+	static char names[128];
+	static int parsed;
+
+	if (!parsed) {
+		if (!PE_parse_boot_argn("sweetdtmode", names, sizeof(names))) {
+			names[0] = '\0';
+		}
+		parsed = 1;
+	}
+	if (names[0] == '\0' || path == NULL) {
+		return false;
+	}
+	const char *base = path;
+	for (const char *c = path; *c; c++) {
+		if (*c == '/') {
+			base = c + 1;
+		}
+	}
+	size_t n = strlen(base);
+	for (const char *t = names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, base, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+#endif
+
 /*
  * exec_extract_strings
  *
@@ -5741,6 +5786,22 @@ exec_extract_strings(struct image_params *imgp)
 		imgp->ip_envc++;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	if (sweet_exec_dtmode(imgp->ip_strings + strlen(EXECUTABLE_KEY))) {
+		error = exec_add_user_string(imgp, CAST_USER_ADDR_T("OS_ACTIVITY_DT_MODE=YES"),
+		    UIO_SYSSPACE, TRUE);
+		if (error) {
+			goto bad;
+		}
+		if (imgp->ip_argspace < new_ptr_size) {
+			error = E2BIG;
+			goto bad;
+		}
+		imgp->ip_argspace -= new_ptr_size;
+		imgp->ip_envc++;
+	}
+#endif
+
 	/* Save space for envv[] NULL terminator */
 	if (imgp->ip_argspace < new_ptr_size) {
 		error = E2BIG;
