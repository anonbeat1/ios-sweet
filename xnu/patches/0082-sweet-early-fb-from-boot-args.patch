 	sweet_early_mark(1, "arm_init entered (MMU on)");
 
 	arm_setup_pre_sign();
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..8f7b65d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1843,7 +1843,7 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = sweet_early_fb_block() | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..799c2a9 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,7 +515,9 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	ldr		x0, [x20, #40]				// boot_args Video.v_baseAddr (PA)
+	MOV64	x6, (2368 * 4320)
+	add		x0, x0, x6
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -686,7 +688,8 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	ldr		x10, [x20, #40]				// boot_args Video.v_baseAddr (PA)
+	and		x10, x10, #~(ARM_TT_L2_SIZE - 1)	// block holding it (Spacewar: 0xe1000000)
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..0e2970a 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -10,8 +10,10 @@
 #if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
+#include <arm64/proc_reg.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+/* boot_args Video.v_baseAddr (V=P under bootstrap TTBR0); NULL until arm_init sets it. */
+static volatile uint32_t *early_fb;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
@@ -42,7 +44,7 @@ sweet_early_clear_row(void)
 void
 sweet_early_putc(char c)
 {
-	if (early_disabled) {
+	if (early_disabled || !early_fb) {
 		return;
 	}
 	if (!early_started) {
@@ -89,7 +91,7 @@ sweet_early_string(const char *s)
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 20) {
+	if (early_disabled || !early_fb || stage > 20) {
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
@@ -112,7 +114,7 @@ sweet_early_mark(unsigned int stage, const char *label)
 void
 sweet_early_panic(const char *fmt, va_list *args)
 {
-	if (early_disabled || early_panicking) {
+	if (early_disabled || !early_fb || early_panicking) {
 		return;
 	}
 	early_panicking = 1;
@@ -125,11 +127,24 @@ sweet_early_panic(const char *fmt, va_list *args)
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+void
+sweet_early_set_fb(uint64_t pa)
+{
+	early_fb = (volatile uint32_t *)(uintptr_t)pa;
+}
+
+uint64_t
+sweet_early_fb_block(void)
+{
+	return (uintptr_t)early_fb & ~(uint64_t)(ARM_TT_L2_SIZE - 1);
+}
+
 void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
-	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	/* Same offset inside the 32MB block (sweet 0, Spacewar 0x1000000). */
+	early_fb = (volatile uint32_t *)(uintptr_t)(base + ((uintptr_t)early_fb & (ARM_TT_L2_SIZE - 1)));
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
