+
+static bool
+sweet_exec_dtmode(const char *path)
+{
+	static char names[256];
+	static int parsed;
+
+	if (!parsed) {
+		if (!PE_parse_boot_argn("sweetdtmode", names, sizeof(names))) {
+			names[0] = '\0';
+		}
+		parsed = 1;
+	}
+	return sweet_list_has(names, path);
+}
+
+/*
+ * SWEET: processes named in boot-arg sweetinsert get
+ * DYLD_INSERT_LIBRARIES=/var/jb/usr/lib/cicpu.dylib in their environment
+ * (xnu 0121 made the AMFI dyld policy allow DYLD_* env vars). The dylib path
+ * is boot-arg sweetinsertlib, default /var/jb/usr/lib/cicpu.dylib.
+ */
+static const char *
+sweet_exec_insert(const char *path)
+{
+	static char names[256], lib[160];
+	static int parsed;
+
+	if (!parsed) {
+		if (!PE_parse_boot_argn("sweetinsert", names, sizeof(names))) {
+			names[0] = '\0';
+		}
+		if (!PE_parse_boot_argn("sweetinsertlib", lib, sizeof(lib))) {
+			strlcpy(lib, "/var/jb/usr/lib/cicpu.dylib", sizeof(lib));
+		}
+		parsed = 1;
+	}
+	return sweet_list_has(names, path) ? lib : NULL;
+}
 #endif
 
