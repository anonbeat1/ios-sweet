+/* Log size and the first 64 bytes of an item (hex), to identify what the remote created. */
+static void
+smem_dump(struct smem_part_hdr *p, uint16_t item, const char *where)
+{
+	uint32_t sz = 0;
+	const uint8_t *v = (const uint8_t *)smem_get(p, item, &sz);
+	char hex[64 * 3 + 1];
+	size_t len = 0;
+
+	if (v == NULL) {
+		LOG("item %u (%s): absent", item, where);
+		return;
+	}
+	hex[0] = '\0';
+	for (uint32_t i = 0; i < sz && i < 64; i++) {
+		len += (size_t)snprintf(hex + len, sizeof(hex) - len, "%02x ", v[i]);
+	}
+	LOG("item %u (%s): %u bytes: %s", item, where, sz, hex);
+}
