index bb2a2bfd6017..fe1a27ad5616 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1039,6 +1039,11 @@ bsd_init(void)
 #endif /* CONFIG_IMAGEBOOT */
 #endif /* CONFIG_BASESYSTEMROOT */
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	extern void sweet_boot_copy(void);
+	sweet_boot_copy();      /* boot-arg sweetcp=/src:/dst (vfs_syscalls.c) */
+#endif
