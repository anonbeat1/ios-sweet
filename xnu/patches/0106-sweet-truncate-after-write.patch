diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index dd47ad9a7d9f..93e09c77a9f1 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -9912,6 +9912,23 @@ sweet_kern_mkdir(const char *path, int mode)
  * boots far enough to fix it.
  */
 void sweet_boot_copy(void);
+int sweet_vnode_set_size(vnode_t vp, off_t size, vfs_context_t ctx);
+
+/*
+ * O_TRUNC passed to vnode_open() does not truncate an existing file here: a
+ * shorter rewrite kept the old tail (launchd.plist 795217 bytes written over
+ * 795496 -> "Unable to parse MRM cache", initproc exit, panic). Writers set
+ * the final size explicitly.
+ */
+int
+sweet_vnode_set_size(vnode_t vp, off_t size, vfs_context_t ctx)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_data_size, size);
+	return vnode_setattr(vp, &va, ctx);
+}
 
