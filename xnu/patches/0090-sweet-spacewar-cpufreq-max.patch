diff --git a/bsd/dev/sweet_cpufreq.c b/bsd/dev/sweet_cpufreq.c
new file mode 100644
index 000000000000..7e657874f979
--- /dev/null
+++ b/bsd/dev/sweet_cpufreq.c
@@ -0,0 +1,92 @@
+/*
+ * SWEET CPU frequency: request the top level of each EPSS cpufreq-hw domain.
+ *
+ * Without a cpufreq driver the cores stay at the level ABL left: on Spacewar
+ * (NOTES.md cpufreq1) the A55 domain runs at index 6 (1516 MHz of 1804) and
+ * the A78 and prime domains at index 0 (691 / 806 MHz of 2400 / 2515).
+ * qcom-cpufreq-hw.c (epss offsets): FREQ_LUT 0x100 (4-byte rows, [31:30] src,
+ * [7:0] L, MHz = L * 19.2), PERF_STATE 0x320 (requested row), DOMAIN_STATE
+ * 0x20 ([7:0] current L). The end of the LUT is a repeated row.
+ *
+ * Domains come from ADT /sweet-cpufreq "reg" (pairs of base, size); sweet has
+ * no node and is unchanged. Thermal limits stay in hardware (LMh/DCVSH clamp
+ * the domain on their own). Boot-args: sweetcpufreq=0 leaves ABL's levels,
+ * sweetcpulevel=N caps the requested row at N.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void sweet_cpufreq_init(void);
+
+#define EPSS_DOMAIN_STATE       0x020u
+#define EPSS_FREQ_LUT           0x100u
+#define EPSS_PERF_STATE         0x320u
+#define EPSS_LUT_MAX            40u
+#define EPSS_MAX_DOMAINS        4u
+
+static uint32_t
+epss_rd(vm_offset_t b, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(b + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static unsigned
+epss_mhz(uint32_t row)
+{
+	return (row >> 30) ? (row & 0xffu) * 192u / 10u : 300u;
+}
+
+void
+sweet_cpufreq_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0, enabled = 1, cap = EPSS_LUT_MAX;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-cpufreq", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess) {
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetcpufreq", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetcpulevel", &cap, sizeof(cap));
+	if (!enabled) {
+		printf("SWEET CPUFREQ: disabled (sweetcpufreq=0), ABL levels kept\n");
+		return;
+	}
+	unsigned n = size / (2 * sizeof(uintptr_t));
+	for (unsigned d = 0; d < n && d < EPSS_MAX_DOMAINS; d++) {
+		vm_offset_t b = ml_io_map(reg[2 * d], reg[2 * d + 1]);
+		if (!b) {
+			printf("SWEET CPUFREQ: domain %u map failed\n", d);
+			continue;
+		}
+		uint32_t prev = 0;
+		unsigned top = 0, i;
+		for (i = 0; i < EPSS_LUT_MAX; i++) {
+			uint32_t row = epss_rd(b, EPSS_FREQ_LUT + 4 * i);
+			if (i > 0 && row == prev) {
+				break;
+			}
+			top = i;
+			prev = row;
+		}
+		if (top > cap) {
+			top = cap;
+		}
+		uint32_t was = epss_rd(b, EPSS_PERF_STATE);
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(b + EPSS_PERF_STATE) = top;
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET CPUFREQ: domain %u level %u -> %u (%u MHz, LUT max %u MHz), current %u MHz\n",
+		    d, was, top, epss_mhz(epss_rd(b, EPSS_FREQ_LUT + 4 * top)),
+		    epss_mhz(epss_rd(b, EPSS_FREQ_LUT + 4 * (i ? i - 1 : 0))),
+		    (epss_rd(b, EPSS_DOMAIN_STATE) & 0xffu) * 192u / 10u);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
