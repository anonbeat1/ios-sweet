+/*
+ * Scale 2: one layer whose rect (dx,dy,w,h) is in logical pixels; each panel
+ * pixel takes the logical pixel fColMap/fRowMap point at (nearest neighbour).
+ */
+void
+AppleCLCD::present_scaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy,
+    int32_t w, int32_t h)
+{
+	uintptr_t src = s->kernelAddress();
+	if (src == 0 || s->memory == NULL || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    (s->bytesPerElement != 0 && s->bytesPerElement != 4)) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w <= 0 || h <= 0 ||
+	    (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4 >
+	    s->memory->getLength()) {
+		return;
+	}
+	/* Panel columns covered by the layer (fColMap is non-decreasing). */
+	uint32_t x0 = 0, x1 = fWidth;
+	while (x0 < fWidth && fColMap[x0] < dx) {
+		x0++;
+	}
+	while (x1 > x0 && fColMap[x1 - 1] >= dx + w) {
+		x1--;
+	}
+	for (uint32_t y = 0; y < fHeight; y++) {
+		int32_t ly = fRowMap[y];
+		if (ly < dy || ly >= dy + h) {
+			continue;
+		}
+		const uint32_t *srow = (const uint32_t *)(src + s->offset +
+		    (uint64_t)(sy + ly - dy) * s->bytesPerRow) + sx - dx;
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+		for (uint32_t x = x0; x < x1; x++) {
+			drow[x] = srow[fColMap[x]];
+		}
+	}
+}
