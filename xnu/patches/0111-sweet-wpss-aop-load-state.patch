+/* ---------------------------------------------------------------- AOP QMP */
+
+static inline uint32_t qmp_rd(uint32_t off) { return *(volatile uint32_t *)(qmp + off); }
+static inline void qmp_wr(uint32_t off, uint32_t v) { *(volatile uint32_t *)(qmp + off) = v; mb(); }
+
+static void
+qmp_kick(void)
+{
+	mb();
+	*(volatile uint32_t *)(ipcc + IPCC_REG_SEND_ID) =
+	    ((uint32_t)IPCC_CLIENT_AOP << 16) | IPCC_SIGNAL_QMP;
+	mb();
+}
+
+static bool
+qmp_wait(uint32_t off, uint32_t want, const char *what)
+{
+	for (int ms = 0; ms < 1000; ms++) {
+		if (qmp_rd(off) == want) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	LOG("QMP: %s timeout (reg %#x = %#x)", what, off, qmp_rd(off));
+	return false;
+}
+
+/* qmp_open(): link handshake, then channel handshake. Returns the mailbox offset or 0. */
+static uint32_t
+qmp_open(void)
+{
+	uint32_t magic = qmp_rd(0), version = qmp_rd(4);
+	uint32_t off = qmp_rd(QMP_MCORE_MBOX_OFF), size = qmp_rd(QMP_MCORE_MBOX_SIZE);
+
+	LOG("QMP: magic %#x version %u mbox %#x+%#x ucore link %#x ch %#x mcore link %#x ch %#x",
+	    magic, version, off, size, qmp_rd(QMP_UCORE_LINK), qmp_rd(QMP_UCORE_CH),
+	    qmp_rd(QMP_MCORE_LINK), qmp_rd(QMP_MCORE_CH));
+	if (magic != QMP_MAGIC || version != QMP_VERSION || size < QMP_MSG_LEN + 4 ||
+	    off + size > QMP_SIZE) {
+		return 0;
+	}
+	qmp_wr(QMP_UCORE_LINK_ACK, qmp_rd(QMP_UCORE_LINK));
+	qmp_wr(QMP_MCORE_LINK, QMP_STATE_UP);
+	qmp_kick();
+	if (!qmp_wait(QMP_MCORE_LINK_ACK, QMP_STATE_UP, "link ack")) {
+		return 0;
+	}
+	qmp_wr(QMP_MCORE_CH, QMP_STATE_UP);
+	qmp_kick();
+	if (!qmp_wait(QMP_UCORE_CH, QMP_STATE_UP, "ucore channel")) {
+		return 0;
+	}
+	qmp_wr(QMP_UCORE_CH_ACK, QMP_STATE_UP);
+	qmp_kick();
+	if (!qmp_wait(QMP_MCORE_CH_ACK, QMP_STATE_UP, "channel ack")) {
+		return 0;
+	}
+	return off;
+}
+
+/* qmp_send(): 64-byte message, 32-bit writes only, the AOP clears the length when done */
+static bool
+qmp_send(uint32_t off, const char *msg)
+{
+	uint32_t buf[QMP_MSG_LEN / 4] = {};
+
+	strlcpy((char *)buf, msg, sizeof(buf));
+	for (unsigned i = 0; i < QMP_MSG_LEN / 4; i++) {
+		*(volatile uint32_t *)(qmp + off + 4 + 4 * i) = buf[i];
+	}
+	qmp_wr(off, QMP_MSG_LEN);
+	(void)qmp_rd(off);
+	qmp_kick();
+	if (!qmp_wait(off, 0, "message ack")) {
+		qmp_wr(off, 0);
+		return false;
+	}
+	return true;
+}
