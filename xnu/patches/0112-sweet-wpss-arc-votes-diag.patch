+/*
+ * ARC (slave 3) corner vote, Linux rpmhpd: the cmd-db aux data of "cx.lvl"/"mx.lvl" is
+ * a table of 16-bit voltage levels (RPMH_REGULATOR_LEVEL_*), and the vote is the index
+ * (hlvl) of the first entry >= the wanted level. Spacewar: the WPSS proxy votes vdd_cx and
+ * vdd_mx at 384 (TURBO) before it is started (SweetWpss.cpp).
+ */
+int
+sweet_rpmh_arc_vote(const char *res, unsigned level)
+{
+	if (!res || (strcmp(res, "cx.lvl") && strcmp(res, "mx.lvl")) || level > 416) {
+		printf("SWEET RPMH: unexpected ARC vote %s %u\n", res ? res : "(null)", level);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux_off = 0, aux_len = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_ARC, &address, &aux_off, &aux_len);
+	}
+	if (!error) {
+		unsigned count = aux_len / 2, hlvl = count;
+		char table[96];
+		size_t len = 0;
+		table[0] = '\0';
+		for (unsigned i = 0; i < count && i < 16; ++i) {
+			unsigned v = rh_db16(aux_off + 2 * i);
+			if (len + 6 < sizeof(table)) {
+				len += (size_t)snprintf(table + len, sizeof(table) - len, " %u", v);
+			}
+			if (hlvl == count && v >= level) {
+				hlvl = i;
+			}
+		}
+		printf("SWEET RPMH: %s levels:%s -> hlvl %u for %u\n", res, table, hlvl, level);
+		if (hlvl >= count) {
+			error = ERANGE;
+		} else {
+			const uint32_t offsets[1] = {0};
+			const uint32_t values[1] = {hlvl};
+			error = rh_send(address, 1, offsets, values);
+		}
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC vote %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
