+/* Log the item ids present in a partition (what the remote has created so far). */
+static void
+smem_list(struct smem_part_hdr *p, const char *what)
+{
+	char line[200];
+	size_t len = 0;
+	unsigned n = 0;
+
+	line[0] = '\0';
+	if (p == NULL || memcmp(p->magic, "$PRT", 4) != 0 || p->free_uncached > p->size) {
+		LOG("SMEM %s: no valid partition", what);
+		return;
+	}
+	uint8_t *e = (uint8_t *)p + sizeof(*p), *end = (uint8_t *)p + p->free_uncached;
+	while (e + sizeof(struct smem_priv_entry) <= end) {
+		struct smem_priv_entry *h = (struct smem_priv_entry *)e;
+		if (h->canary != 0xA5A5) {
+			break;
+		}
+		if (len + 8 < sizeof(line)) {
+			len += (size_t)snprintf(line + len, sizeof(line) - len, " %u", h->item);
+		}
+		n++;
+		e += sizeof(*h) + h->pad_hdr + h->size;
+	}
+	LOG("SMEM %s: %u items (hosts %u/%u, used %#x of %#x):%s", what, n, p->host0, p->host1,
+	    p->free_uncached, p->size, line);
+}
