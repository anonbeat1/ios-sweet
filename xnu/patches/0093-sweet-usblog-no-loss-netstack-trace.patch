+/* Trace: InterfaceNamer (configd) opening the stack means it saw IOKit network objects. */
+bool
+SweetNetworkStackUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	char name[32] = "?";
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET NET: %s opened IONetworkStack (type %u)\n", name, (unsigned)type);
+	return IOUserClient::initWithTask(owningTask, securityID, type);
+}
