+static uint32_t
+sweet_adt_u32(IORegistryEntry *entry, const char *key)
+{
+	OSData *data = OSDynamicCast(OSData, entry->getProperty(key));
+	return data && data->getLength() == sizeof(uint32_t) ?
+	       *(const uint32_t *)data->getBytesNoCopy() : 0;
+}
