+/*
+ * Calendar seed for clock_initialize_calendar(). ADT /sweet-rtc (Spacewar):
+ * the PMK8350 RTC counts seconds from an arbitrary base; Qualcomm's
+ * time_daemon keeps "real time - RTC" in persist (time/ats_2, ms), copied
+ * into offset-ms by tools/mkadt.py. Without the node (sweet): epoch, as before.
+ */
+void
+SweetPlatformExpert::getUTCTimeOfDay(clock_sec_t *secs, clock_nsec_t *nsecs)
+{
+	*secs = 0;
+	*nsecs = 0;
+	IORegistryEntry *rtc = IORegistryEntry::fromPath("/sweet-rtc", gIODTPlane);
+	if (rtc == NULL) {
+		return;
+	}
+	unsigned base = sweet_adt_u32(rtc, "base");
+	OSData *offset = OSDynamicCast(OSData, rtc->getProperty("offset-ms"));
+	uint64_t offset_ms = offset && offset->getLength() == sizeof(uint64_t) ?
+	    *(const uint64_t *)offset->getBytesNoCopy() : 0;
+	rtc->release();
+
+	uint8_t ctrl = 0, b[4] = { 0, 0, 0, 0 }, again = 0;
+	if (!base || sweet_spmi_init() || sweet_spmi_read(0, base + 0x46, &ctrl) || !(ctrl & 0x80)) {
+		IOLog("SWEET RTC: unavailable (base %#x ctrl %#x)\n", base, ctrl);
+		return;
+	}
+	/* RDATA0..3 (rtc-pm8xxx pmk8350 layout); re-read if the low byte rolled over. */
+	for (int tries = 0; tries < 3; tries++) {
+		for (int i = 0; i < 4; i++) {
+			if (sweet_spmi_read(0, base + 0x48 + i, &b[i])) {
+				IOLog("SWEET RTC: read failed\n");
+				return;
+			}
+		}
+		if (sweet_spmi_read(0, base + 0x48, &again) == 0 && again == b[0]) {
+			break;
+		}
+	}
+	uint32_t raw = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+	*secs = (clock_sec_t)(raw + offset_ms / 1000);
+	IOLog("SWEET RTC: raw %u s + offset %llu ms -> %lu\n", raw, offset_ms, (unsigned long)*secs);
+}
