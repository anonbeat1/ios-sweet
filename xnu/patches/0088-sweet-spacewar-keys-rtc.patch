+		&keys_gpio_ppid, &keys_gpio_base,
+	};
+	for (int i = 0; i < 6; i++) {
+		const uint32_t *v;
+		unsigned int size;
+		if (SecureDTGetProperty(node, names[i], (void const **)&v, &size) == kSuccess &&
+		    size == sizeof(uint32_t)) {
+			*vals[i] = *v;
+		}
+	}
+}
