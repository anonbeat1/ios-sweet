+ * and files installed, without a shell: TCP 192.168.7.2:5141, one request
+ * per connection, one line:
+ *   LS /dir               -> "OK\n" then "<d|f|l|?> <size> <name>\n" per entry.
+ *   GET /file             -> "OK <size>\n" then the bytes.
+ *   PUT <mode> <size> /f  -> then <size> bytes; file replaced, mode set (octal,
+ *                            setuid bits included) -> "OK\n".
+ *   MKDIR <mode> /dir     -> "OK\n" (also when it exists).
+ *   SYMLINK /link target  -> "OK\n" (an existing /link is replaced).
+ *   error -> "ERR <errno>\n". The connection is closed after each reply.
+ * Runs as the kernel (no permission checks); only reachable over the USB
+ * link. Host side: tools/sweet-pull.py. Boot-arg sweetfs=0 disables it.
  */
 #define UD_FS_PORT      5141
 
