+static int
+ud_fs_chmod(const char *path, int mode, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int err = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err == 0) {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, mode & 07777);
+		err = vnode_setattr(vp, &va, ctx);
+		vnode_put(vp);
+	}
+	return err;
+}
+
+/* PUT: the request line has been read; "extra" bytes of the body came with it. */
+static int
+ud_fs_put(socket_t so, const char *path, int mode, off_t size, const char *extra,
+    size_t nextra, vfs_context_t ctx)
+{
+	static char fbuf[65536];
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, mode & ACCESSPERMS,
+	    0, &vp, ctx);
+	if (err != 0) {
+		return err;
+	}
+	off_t off = 0;
+	while (off < size) {
+		size_t len;
+		if (nextra > 0) {
+			len = MIN(nextra, (size_t)(size - off));
+			memcpy(fbuf, extra, len);
+			nextra = 0;
+		} else {
+			struct iovec iov = { .iov_base = fbuf, .iov_len = (size_t)MIN((off_t)sizeof(fbuf), size - off) };
+			struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+			len = 0;
+			err = sock_receive(so, &msg, 0, &len);
+			if (err == 0 && len == 0) {
+				err = EPIPE;
+			}
+			if (err != 0) {
+				break;
+			}
+		}
+		int resid = 0;
+		err = vn_rdwr(UIO_WRITE, vp, fbuf, (int)len, off, UIO_SYSSPACE, IO_NOAUTH,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (err == 0 && resid != 0) {
+			err = ENOSPC;
+		}
+		if (err != 0) {
+			break;
+		}
+		off += (off_t)len;
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return err != 0 ? err : ud_fs_chmod(path, mode, ctx);
+}
