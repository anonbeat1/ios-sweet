+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* SWEET: mkdir of a kernel-space path with the kernel context (bsd/dev/sweet_usb.c). */
+int sweet_kern_mkdir(const char *path, int mode);
+
+int
+sweet_kern_mkdir(const char *path, int mode)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & ACCESSPERMS);
+	return mkdir1at(vfs_context_kernel(), CAST_USER_ADDR_T(path), &va, AT_FDCWD,
+	           UIO_SYSSPACE);
+}
+#endif
